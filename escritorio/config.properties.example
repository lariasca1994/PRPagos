# =====================================================================
# PRPagos Escritorio — configuración (escritorio/config.properties.example)
#
# La lee conexion/ConexionBD.java al conectarse. Plantilla: cópiala sin el
# .example y completa tus datos reales.
#
# Dónde va:
#   - Desde el código: escritorio/config.properties.
#   - Aplicación instalada (PRPagos.exe): %APPDATA%\PRPagos\config.properties,
#     con la carpeta wallet al lado (wallet.path=wallet).
#   - Otro equipo: copia este archivo con las claves EN CLARO; uno que ya dice
#     "dpapi:..." solo sirve en el equipo y el usuario de Windows que lo cifró.
#
# Protección: en Windows, la primera vez que la aplicación lee el archivo
# cifra db.password, totp.clave y brevo.api.key con DPAPI (quedan como
# "dpapi:..."), atados a tu usuario de Windows en este equipo. Para cambiar
# uno, vuelve a escribirlo en claro y la aplicación lo cifrará de nuevo.
# =====================================================================

# ── Base de datos: Oracle Autonomous Database ────────────────────────
# Las mismas que web/.env (WALLET_PATH, DB_ALIAS, DB_USUARIO, DB_PASSWORD).

# Carpeta del Wallet descargado de Oracle Cloud (relativa a este archivo o
# absoluta). El escritorio usa el Wallet SSO: no necesita contraseña.
wallet.path=../wallet
# Alias de conexión de wallet/tnsnames.ora (el que termina en _tp).
db.alias=TU_BASE_tp
# Usuario y contraseña de la base.
db.usuario=ADMIN
db.password=TU_PASSWORD_AQUI

# ── Verificación en dos pasos (TOTP) ─────────────────────────────────
# Clave AES-256 (32 bytes en base64) que cifra los autenticadores en la base.
# Debe ser la MISMA que TOTP_CLAVE de web/.env (y de Cloud Run): así un
# autenticador configurado en una versión funciona en la otra.
totp.clave=TU_CLAVE_BASE64_DE_32_BYTES

# ── Correos: Brevo ───────────────────────────────────────────────────
# API de Brevo para enviar correos desde el escritorio. Es la MISMA clave
# que BREVO_API_KEY de web/.env (una sola cuenta de Brevo para las dos).
brevo.api.key=TU_API_KEY_DE_BREVO_AQUI
# Correo remitente verificado en Brevo (el mismo BREVO_REMITENTE de la web).
brevo.remitente=tu-correo-verificado@dominio.com
# Opcional: dirección pública de la web para el enlace de los correos.
# url.publica=https://tu-servicio.run.app
