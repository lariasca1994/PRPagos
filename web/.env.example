# Copia este archivo como .env (sin el .example) y completa tus datos
# reales. .env nunca se sube a git (ver .gitignore).

# Ruta a la carpeta del Wallet de Oracle Cloud (la misma que usa la version
# de escritorio) -- relativa a donde arranques uvicorn, o una ruta absoluta.
WALLET_PATH=../wallet

# Contraseña del Wallet (la que pusiste al descargar el .zip del Wallet
# desde la consola de OCI). La app de escritorio no la necesita porque usa
# el wallet SSO (cwallet.sso, sin contraseña), pero python-oracledb en modo
# thin usa el ewallet.pem, que sigue protegido con esa contraseña.
WALLET_PASSWORD=TU_PASSWORD_DEL_WALLET_AQUI

# Alias de conexion tomado de wallet/tnsnames.ora (el que termina en _tp)
DB_ALIAS=TU_BASE_tp

# Usuario y password de tu Autonomous Database (el mismo ADMIN de siempre)
DB_USUARIO=ADMIN
DB_PASSWORD=TU_PASSWORD_AQUI

# Secreto para firmar los JWT de sesion -- genera uno con:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=genera-un-secreto-largo-y-aleatorio-aqui
