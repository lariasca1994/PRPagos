# =====================================================================
# PRPagos Web — variables de entorno (web/.env.example)
#
# Lo leen la app web (app/config.py), migrar.py y los comandos de
# app/comandos/. En producción no se usa ningún archivo: las mismas
# variables están configuradas en el servicio de Google Cloud Run.
# La web es el único origen de datos: la app de escritorio no tiene
# configuración ni claves, todo lo pide a la API de la web.
# Plantilla: cópiala sin el .example y completa tus datos reales.
# =====================================================================

# ── Base de datos: Oracle Autonomous Database ────────────────────────

# Carpeta del Wallet descargado de Oracle Cloud (relativa a web/ o absoluta).
WALLET_PATH=../wallet
# Contraseña del Wallet (la del .zip descargado de OCI).
WALLET_PASSWORD=TU_PASSWORD_DEL_WALLET_AQUI
# Alias de conexión de wallet/tnsnames.ora (el que termina en _tp).
DB_ALIAS=TU_BASE_tp
# Usuario propio de la aplicación (sin permisos para crear ni borrar tablas;
# nunca ADMIN) y su contraseña.
DB_USUARIO=TU_USUARIO_DE_LA_APP
DB_PASSWORD=TU_PASSWORD_AQUI
# Esquema dueño de las tablas y procedimientos (vacío si es el mismo usuario).
DB_ESQUEMA=TU_ESQUEMA_DUENO

# ── Sesiones web ─────────────────────────────────────────────────────
# Firma los JWT de sesión (cookie). Solo la web. Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=genera-un-secreto-largo-y-aleatorio-aqui

# ── Verificación en dos pasos (TOTP) ─────────────────────────────────
# Clave AES-256 (32 bytes en base64) que cifra los autenticadores en la base.
# La MISMA aquí y en Cloud Run. Si cambia con cuentas que ya tienen
# autenticador, hay que volver a cifrar sus secretos con la nueva. Genera
# una con:
#   python -c "import base64, secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
TOTP_CLAVE=genera-una-clave-de-32-bytes-en-base64-aqui

# ── Correos: Brevo ───────────────────────────────────────────────────
# API de Brevo para los resúmenes por correo (semanal los viernes, mensual el
# día 29) y los códigos de recuperación. La MISMA clave va en Cloud Run; los
# correos que se piden desde el escritorio también los envía el servidor.
BREVO_API_KEY=TU_API_KEY_DE_BREVO_AQUI
# Correo remitente: debe estar verificado en Brevo (Senders & IP).
BREVO_REMITENTE=tu-correo-verificado@dominio.com

# ── Resúmenes programados ────────────────────────────────────────────
# El workflow .github/workflows/resumenes.yml llama cada día a
# POST /tareas/resumenes con este token (secreto TAREAS_TOKEN del repositorio
# en GitHub y la misma variable en Cloud Run). Sin token la tarea queda
# desactivada. Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TAREAS_TOKEN=genera-un-token-largo-y-aleatorio-aqui
# Dirección pública de la web (enlace "Abrir el dashboard" de los correos).
URL_PUBLICA=https://tu-servicio.run.app

# ── Servidor ─────────────────────────────────────────────────────────
# Puerto del contenedor (opcional; Cloud Run lo define solo). En local,
# uvicorn usa 8000 salvo que se indique --port.
PORT=8080
