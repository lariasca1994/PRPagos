# =====================================================================
# PRPagos Web — variables de entorno (web/.env.example)
#
# Lo leen la app web (app/config.py), migrar_seguridad.py y los comandos de
# app/comandos/. En producción no se usa ningún archivo: las mismas
# variables están configuradas en el servicio de Google Cloud Run.
# Plantilla: cópiala sin el .example y completa tus datos reales.
# =====================================================================

# ── Base de datos: Oracle Autonomous Database ────────────────────────
# Las mismas que escritorio/config.properties (wallet.path, db.alias,
# db.usuario, db.password).

# Carpeta del Wallet descargado de Oracle Cloud (relativa a web/ o absoluta).
WALLET_PATH=../wallet
# Contraseña del Wallet (la del .zip descargado de OCI). Solo la web la
# necesita: el escritorio usa el Wallet SSO, que no tiene contraseña.
WALLET_PASSWORD=TU_PASSWORD_DEL_WALLET_AQUI
# Alias de conexión de wallet/tnsnames.ora (el que termina en _tp).
DB_ALIAS=TU_BASE_tp
# Usuario y contraseña de la base.
DB_USUARIO=ADMIN
DB_PASSWORD=TU_PASSWORD_AQUI

# ── Sesiones web ─────────────────────────────────────────────────────
# Firma los JWT de sesión (cookie). Solo la web. Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=genera-un-secreto-largo-y-aleatorio-aqui

# ── Verificación en dos pasos (TOTP) ─────────────────────────────────
# Clave AES-256 (32 bytes en base64) que cifra los autenticadores en la base.
# Debe ser la MISMA aquí, en totp.clave de escritorio/config.properties y
# en Cloud Run. No la cambies cuando ya haya cuentas con autenticador. Genera
# una con:
#   python -c "import base64, secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
TOTP_CLAVE=genera-una-clave-de-32-bytes-en-base64-aqui

# ── Correos: Brevo ───────────────────────────────────────────────────
# API de Brevo para los resúmenes por correo (semanal los viernes, mensual el
# día 29). La MISMA clave va en Cloud Run y en brevo.api.key de
# escritorio/config.properties (el escritorio también envía correos).
BREVO_API_KEY=TU_API_KEY_DE_BREVO_AQUI

# ── Servidor ─────────────────────────────────────────────────────────
# Puerto del contenedor (opcional; Cloud Run lo define solo). En local,
# uvicorn usa 8000 salvo que se indique --port.
PORT=8080
